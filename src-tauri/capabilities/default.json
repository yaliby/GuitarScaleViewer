{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "allow-get-current-media",
    "allow-control-media-playback",
    "allow-seek-media",
    "allow-get-media-sessions-debug",
    "allow-get-detected-key",
    "allow-reset-detected-key",
    "allow-set-cloud-resolution",
    "allow-get-cloud-resolution",
    "allow-resolve-playalong",
    "allow-follow-playalong",
    "allow-capture-track",
    "allow-lookup-track-capture",
    "allow-list-track-captures",
    "allow-map-track-lyrics",
    "allow-make-track-stems",
    "allow-recognition-available",
    "allow-recognition-run",
    "allow-recognition-cancel",
    "allow-song-memory"
  ]
}
