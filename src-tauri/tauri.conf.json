{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fretboard Studio",
  "mainBinaryName": "fretboard-studio",
  "version": "0.1.0",
  "identifier": "com.fretboardstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Fretboard Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; font-src 'self' data:; connect-src 'self' https: ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "sidecars/key_analyzer/key_analyzer.py",
      "sidecars/libkeyfinder_cli/main.cpp",
      "sidecars/libkeyfinder_cli/CMakeLists.txt"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
