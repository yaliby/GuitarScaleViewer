{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fretboard Studio",
  "version": "0.1.0",
  "identifier": "com.fretboardstudio.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Fretboard Studio",
        "width": 1440,
        "height": 960,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": { "sidecars/key_analyzer/dist/key_analyzer/": "analyzer/" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
